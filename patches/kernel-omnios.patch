diff --git a/Makefile b/Makefile
index 68a8faff2..2fd305123 100644
--- a/Makefile
+++ b/Makefile
@@ -1281,9 +1281,8 @@ export INSTALL_HDR_PATH = $(objtree)/usr
 
 quiet_cmd_headers_install = INSTALL $(INSTALL_HDR_PATH)/include
       cmd_headers_install = \
-	mkdir -p $(INSTALL_HDR_PATH); \
-	rsync -mrl --include='*/' --include='*\.h' --exclude='*' \
-	usr/include $(INSTALL_HDR_PATH)
+	mkdir -p $(INSTALL_HDR_PATH)/include; \
+	( cd usr/include && find . -name '*.h' -print | xargs -r cp --parents -t $(INSTALL_HDR_PATH)/include )
 
 PHONY += headers_install
 headers_install: headers
diff --git a/arch/x86/Kconfig b/arch/x86/Kconfig
index 7b9a7e8f3..986d31c39 100644
--- a/arch/x86/Kconfig
+++ b/arch/x86/Kconfig
@@ -261,7 +261,11 @@ config X86
 	select HAVE_NOINSTR_HACK		if HAVE_OBJTOOL
 	select HAVE_NMI
 	select HAVE_NOINSTR_VALIDATION		if HAVE_OBJTOOL
-	select HAVE_OBJTOOL			if X86_64
+	# OmniOS: HAVE_OBJTOOL left unselected. The build host has no libelf
+	# development headers (and no reachable elfutils mirror), so the in-tree
+	# objtool cannot be compiled. Every consumer of objtool is guarded by
+	# 'if HAVE_OBJTOOL', so they all fall back to their non-objtool paths.
+	# select HAVE_OBJTOOL			if X86_64
 	select HAVE_OPTPROBES
 	select HAVE_PAGE_SIZE_4KB
 	select HAVE_PCSPKR_PLATFORM
diff --git a/include/linux/objtool.h b/include/linux/objtool.h
index b3b8d3dab..42a402dae 100644
--- a/include/linux/objtool.h
+++ b/include/linux/objtool.h
@@ -167,6 +167,12 @@
 .endm
 .macro REACHABLE
 .endm
+/* OmniOS: when CONFIG_OBJTOOL is off, the UNRET validation annotations are
+ * still referenced by arch/x86/include/asm/unwind_hints.h but only objtool
+ * would ever consume their .discard.validate_unret sections, so make them
+ * no-ops (mirrors VALIDATE_UNRET_END in asm/nospec-branch.h). */
+.macro VALIDATE_UNRET_BEGIN
+.endm
 #endif
 
 #endif /* CONFIG_OBJTOOL */
