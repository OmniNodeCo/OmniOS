#!/bin/bash
# Hand the operating-system identity back to Debian when OmniOS branding is
# removed, so the system is left in a working state rather than with a
# dangling diverted file.
set -Eeuo pipefail

case "${1:-}" in
    remove | deconfigure)
        rm -f /etc/xdg/kcm-about-distrorc
        if dpkg-divert --list /etc/xdg/kcm-about-distrorc \
            | grep -q /etc/xdg/kcm-about-distrorc; then
            dpkg-divert --package omnios-desktop --remove --rename --quiet \
                --divert /etc/xdg/kcm-about-distrorc.debian \
                /etc/xdg/kcm-about-distrorc
        fi
        rm -f /etc/default/grub.d/10-omnios.cfg

        # Restore Debian's os-release by hand: the diversion was added with
        # --no-rename, so dpkg will not move the file back for us.
        if dpkg-divert --list /usr/lib/os-release | grep -q /usr/lib/os-release; then
            dpkg-divert --package omnios-desktop --remove --no-rename --quiet \
                --divert /usr/lib/os-release.debian /usr/lib/os-release
        fi
        if [ -e /usr/lib/os-release.debian ]; then
            mv -f /usr/lib/os-release.debian /usr/lib/os-release
        fi
        ln -sfn ../usr/lib/os-release /etc/os-release
        ;;
    upgrade | failed-upgrade) ;;
    *) ;;
esac

#DEBHELPER#

exit 0
