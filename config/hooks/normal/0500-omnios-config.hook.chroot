#!/bin/bash
set -Eeuo pipefail

# The OmniOS identity, branding and system integration are applied by the
# omnios-desktop package, which live-build installs from
# config/packages.chroot. Its postinst owns the os-release diversion and the
# KDE branding, so doing that work here as well would create a competing
# --local diversion that the package could never take over, and that would be
# left dangling if the package were ever removed.
#
# /etc/debian_version is deliberately left alone: it records the Debian base
# release and package tooling parses it as such.
if ! dpkg-query -W -f='${Status}' omnios-desktop 2>/dev/null \
    | grep -q 'install ok installed'; then
    echo 'ERROR: omnios-desktop is not installed in the image.' >&2
    echo 'The OmniOS identity and the update channel come from that package.' >&2
    exit 1
fi
printf 'omnios\n' > /etc/hostname
if [[ -f /etc/hosts ]] && ! grep -qE '^127\.0\.1\.1[[:space:]]+omnios' /etc/hosts; then
    printf '127.0.1.1 omnios\n' >> /etc/hosts
fi

# Apply OmniOS branding on top of Debian's maintained Calamares integration.
install -d /etc/calamares/branding/omnios
cp -a /usr/share/omnios/calamares/branding/omnios/. /etc/calamares/branding/omnios/
cp /usr/share/omnios/calamares/partition.conf /etc/calamares/modules/partition.conf
install -m 0755 /usr/share/omnios/calamares/calamares-sources-final \
    /usr/share/calamares/helpers/calamares-sources-final
sed -i 's/^branding:[[:space:]].*/branding: omnios/' /etc/calamares/settings.conf

# Keep Debian's tested launcher, but present it as the OmniOS installer.
if [[ -f /usr/share/applications/calamares-install-debian.desktop ]]; then
    sed -i \
        -e 's/^Name=.*/Name=Install OmniOS/' \
        -e 's/^GenericName=.*/GenericName=System Installer/' \
        -e 's/^Comment=.*/Comment=Install OmniOS on this computer/' \
        -e 's/^Icon=.*/Icon=install-omnios/' \
        /usr/share/applications/calamares-install-debian.desktop
fi
if [[ -f /etc/xdg/autostart/calamares-desktop-icon.desktop ]]; then
    printf '\nHidden=true\n' >> /etc/xdg/autostart/calamares-desktop-icon.desktop
fi

# The GRUB defaults are written by the omnios-desktop postinst, so that an
# update to them also reaches installed systems.

systemctl enable omnios-firstboot.service
systemctl enable omnios-antivirus-scan.timer
systemctl enable omnios-flathub.service
systemctl enable NetworkManager.service
systemctl enable firewalld.service
systemctl enable apparmor.service
systemctl enable auditd.service
systemctl enable clamav-daemon.service
systemctl enable clamav-freshclam.service
systemctl enable unattended-upgrades.service

# Do not clone the build system's identity into every installation.
truncate -s 0 /etc/machine-id
rm -f /var/lib/dbus/machine-id
apt-get clean
rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
