#!/bin/bash
set -Eeuo pipefail

install -d -m 0755 /var/lib/omnios

# The installer launcher belongs only in the live session.
rm -f /usr/share/applications/install-omnios.desktop \
    /etc/skel/Desktop/install-omnios.desktop
find /home -mindepth 3 -maxdepth 3 -type f \
    -path '*/Desktop/install-omnios.desktop' -delete 2>/dev/null || true

if [[ "$(findmnt --noheadings --output FSTYPE /)" == btrfs ]]; then
    if ! snapper --config root get-config >/dev/null 2>&1; then
        snapper --config root create-config /
    fi
    snapper --config root set-config \
        TIMELINE_CREATE=yes \
        TIMELINE_CLEANUP=yes \
        TIMELINE_LIMIT_HOURLY=10 \
        TIMELINE_LIMIT_DAILY=7 \
        TIMELINE_LIMIT_WEEKLY=4 \
        TIMELINE_LIMIT_MONTHLY=3
    systemctl enable --now snapper-timeline.timer snapper-cleanup.timer
fi

touch /var/lib/omnios/firstboot-complete
