#!/bin/bash
set -Eeuo pipefail

install -d -m 0755 /var/lib/omnios

# Enable the OmniOS update channel, which ships disabled so that a not yet
# published archive cannot fail the image build. Only enable it once the
# archive really answers and the signing key is present, so a machine is never
# left with an apt source that breaks every "apt update".
omnios_sources=/etc/apt/sources.list.d/omnios.sources
omnios_keyring=/usr/share/keyrings/omnios-archive-keyring.asc
if [[ -f "$omnios_sources" ]] && grep -q '^Enabled: no$' "$omnios_sources"; then
    url="$(awk '/^URIs:/ { print $2; exit }' "$omnios_sources")"
    suite="$(awk '/^Suites:/ { print $2; exit }' "$omnios_sources")"
    if [[ -s "$omnios_keyring" ]] \
        && curl --fail --silent --show-error --location --max-time 20 \
            --output /dev/null "$url/dists/$suite/Release" 2>/dev/null; then
        sed -i 's/^Enabled: no$/Enabled: yes/' "$omnios_sources"
        echo "omnios-firstboot: enabled the OmniOS update channel at $url"
    else
        echo "omnios-firstboot: OmniOS archive not reachable yet, leaving it disabled" >&2
    fi
fi

# The installer launcher belongs only in the live session.
rm -f /usr/share/applications/install-omnios.desktop \
    /etc/skel/Desktop/install-omnios.desktop
find /home -mindepth 3 -maxdepth 3 -type f \
    -path '*/Desktop/install-omnios.desktop' -delete 2>/dev/null || true

if systemctl is-active --quiet firewalld.service; then
    firewall-cmd --set-default-zone=public
fi

if [[ "$(findmnt --noheadings --output FSTYPE /)" == btrfs ]]; then
    if ! snapper --config root get-config >/dev/null 2>&1; then
        snapper --config root create-config /
    fi
    snapper --config root set-config \
        TIMELINE_CREATE=yes \
        TIMELINE_CLEANUP=yes \
        TIMELINE_LIMIT_HOURLY=10 \
        TIMELINE_LIMIT_DAILY=7 \
        TIMELINE_LIMIT_WEEKLY=4 \
        TIMELINE_LIMIT_MONTHLY=3
    systemctl enable --now snapper-timeline.timer snapper-cleanup.timer
fi

touch /var/lib/omnios/firstboot-complete
