#!/usr/bin/env bash
set -Eeuo pipefail
CONFIG=/etc/omnios/update.conf
LOCK=/run/lock/omnios-update.lock
STATE_DIR=/data/omnios-update
LAST_HASH="$STATE_DIR/last-bundle.sha256"
log() { printf 'omnios-update: %s\n' "$*"; }
[[ -r "$CONFIG" ]] || { log "configuration not found"; exit 0; }
# shellcheck disable=SC1090
. "$CONFIG"
[[ "${ENABLED:-0}" == 1 ]] || { log 'automatic updates are disabled'; exit 0; }
case "${BUNDLE_URL:-}" in https://*) ;; *) log 'BUNDLE_URL must use HTTPS'; exit 1;; esac
[[ "$BUNDLE_URL" != *'.invalid'* ]] || { log 'replace placeholder BUNDLE_URL'; exit 1; }
install -d -m 0755 "$(dirname -- "$LOCK")" "$STATE_DIR"
exec 9>"$LOCK"
flock --nonblock 9 || { log 'another update process is running'; exit 0; }
tmp_bundle="$(mktemp --tmpdir="$STATE_DIR" .bundle.XXXXXX.raucb)"
trap 'rm -f -- "$tmp_bundle"' EXIT
log "checking ${CHANNEL:-stable} channel"
curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --connect-timeout 20 --max-time 3600 \
  --max-filesize "${MAX_BUNDLE_BYTES:-17179869184}" \
  --output "$tmp_bundle" "$BUNDLE_URL"
bundle_hash="$(sha256sum "$tmp_bundle" | cut -d' ' -f1)"
if [[ -r "$LAST_HASH" ]] && [[ "$(cat "$LAST_HASH")" == "$bundle_hash" ]]; then
    log 'latest bundle is already installed'; exit 0
fi
rauc info "$tmp_bundle" >/dev/null
rauc install "$tmp_bundle"
printf '%s\n' "$bundle_hash" > "$LAST_HASH"
sync
touch /run/omnios-reboot-required
log 'signed update installed into the inactive slot'
if [[ "${AUTO_REBOOT:-0}" == 1 ]]; then systemctl reboot; else log 'reboot required; failed trial boots roll back'; fi
