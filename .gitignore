# build outputs and package cache (anchored: the kernel source in
# os/kernel/src has directories named build and src of its own)
/build/
/.cache/

# Upstream source checkouts (git-cloned; see README "Build"). The Linux
# kernel is not one of them: its source is in os/kernel/src.
/src/

# C objects left by the os/ build (built in-tree, installed into build/)
*.o

# Generated release files
out/
*.iso
*.hybrid.iso
*.img
*.qcow2
*.vmdk
*.zsync
*.sha256
*.packages

# Local credentials and signing material
.keys/
*.key
*.key.pem

# Python/editor files
.venv/
__pycache__/
*.pyc
*.swp
*~
.DS_Store
