#! name: Hello
#! icon: H
# Your first OmniOS program. Press Run (F5) in OmniOS Code, or type
# "omx run hello.oms" in the Terminal.

let name = input("What's your name? ")
if not name {
    name = "friend"
}
print("Hello, " + name + "! Welcome to OmniOS.")

# functions, lists and loops
fn square(n) {
    return n * n
}
let squares = []
for i in range(1, 6) {
    push(squares, square(i))
}
print("The first squares are", squares)
