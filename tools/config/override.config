# OmniOS kernel overrides (trixie thin kernel, layered on arch/x86/configs/x86_64_defconfig)
# Kept small: everything driven by the desktop needs the GUI/framebuffer path.

# --- initrd (embedded initramfs) ---
CONFIG_BLK_DEV_INITRD=y

# --- TTY / console / framebuffer console (boot + fallback text) ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- framebuffer core (simpledrm + VESA fallback == real display) ---
CONFIG_FB=y
CONFIG_FB_NOTIFY=y
CONFIG_FB_VESA=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# --- basic device model / proc / sys / tmpfs / devtmpfs ---
CONFIG_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# --- no module loader (full monolith) ---
CONFIG_MODULES=n

# --- the GUI's input/output device paths ---
# /dev/input/mice (legacy pointer fallback; the desktop prefers evdev)
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
#
# Input BACKEND drivers.  The x86 defconfig is allnoconfig plus a small
# fragment that enables the evdev/mousedev *frontends* only — without these
# the guest kernel never probes the hypervisor's PS/2 or USB mouse or
# keyboard, so the desktop would see no pointer and no keys at all.
#   SERIO_I8042 + KEYBOARD_ATKBD + MOUSE_PS2 : PS/2 port (VMware,
#                                              VirtualBox, QEMU, physical PC)
#   USB_HID                                  : USB mice/keyboards
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_USB_HID=y
# generic firmware framebuffer -> simpledrm (EFI/BIOS VGA/VESA fallback path)
CONFIG_SYSFB_SIMPLEFB=y

# --- kernel build environment constraints ---
# No OpenSSL headers on the build host -> drop the trusted-keyring cert
# extraction (we are a monolithic kernel: no module signatures needed).
# No wireless stack is shipped (no firmware), and CFG80211 pulls in the
# signed-regdb -> SYSTEM_DATA_VERIFICATION -> trusted-keyring select chain,
# so disabling it removes the openssl-dependent certs/extract-cert host tool.
CONFIG_CFG80211=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_SYSTEM_REVOCATION_LIST=n

# --- ORC/IBT need the host objtool (libelf/pkg-config); use the frame-pointer
#     unwinder and skip retpoline instrumentation so objtool is never required.
CONFIG_UNWINDER_ORC=n
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_X86_KERNEL_IBT=n
CONFIG_MITIGATION_RETPOLINE=n

# --- ftrace mcount would pull in objtool (HAVE_OBJTOOL_MCOUNT); not needed.
CONFIG_FUNCTION_TRACER=n

# --- VMware / hypervisor friendliness -------------------------------------
# VMware's virtual SVGA adapter (framebuffer in a VM without any extra setup)
CONFIG_DRM_VMWGFX=y
# VMware/hypervisor support: stable early consoles + precise time in a VM
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VMWARE_BALLOON=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMWARE_VMCI=y

# --- built-in kernel command line ------------------------------------------
# The EFI stub boots without a boot-manager cmdline in VMware; bake in a
# default so early boot prints land on both the VGA console and the serial
# port (the .vmx logs serial0 to omnios-serial.log), which makes a blank-VM
# boot diagnosable. ttyS0 mirrors the framebuffer console for the desktop.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200n8 console=tty1"
CONFIG_CMDLINE_OVERRIDE=n
