# OmniOS kernel overrides (trixie thin kernel, layered on arch/x86/configs/x86_64_defconfig)
# Kept small: everything driven by the desktop needs the GUI/framebuffer path.

# --- initrd (embedded initramfs) ---
CONFIG_BLK_DEV_INITRD=y

# --- TTY / console / framebuffer console (boot + fallback text) ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- framebuffer core (simpledrm + VESA fallback == real display) ---
CONFIG_FB=y
CONFIG_FB_NOTIFY=y
CONFIG_FB_VESA=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# QEMU's standard VGA (also Proxmox's default display). The firmware's
# framebuffer covers UEFI boots, but a BIOS boot (ISOLINUX sets no VESA
# mode) has none: without a driver for the adapter there is no /dev/fb0 and
# no desktop. VMware's adapter has vmwgfx (below).
CONFIG_DRM_BOCHS=y
# no penguin on the screen while booting
CONFIG_LOGO=n

# --- basic device model / proc / sys / tmpfs / devtmpfs ---
CONFIG_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# --- no module loader (full monolith) ---
CONFIG_MODULES=n

# --- the GUI's input/output device paths ---
# /dev/input/mice (legacy pointer fallback; the desktop prefers evdev)
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
#
# Input BACKEND drivers.  The x86 defconfig is allnoconfig plus a small
# fragment that enables the evdev/mousedev *frontends* only — without these
# the guest kernel never probes the hypervisor's PS/2 or USB mouse or
# keyboard, so the desktop would see no pointer and no keys at all.
#   SERIO_I8042 + KEYBOARD_ATKBD + MOUSE_PS2 : PS/2 port (VMware,
#                                              VirtualBox, QEMU, physical PC)
#   USB_HID                                  : USB mice/keyboards
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_USB_HID=y
#   MOUSE_PS2_VMMOUSE : VMware's absolute pointer ("VirtualPS/2 VMware
#     VMMouse"). Without it VMware keeps the pointer on the host until the
#     user clicks into the VM to grab it; with it the host pointer passes
#     straight into the guest as absolute positions (ABS_X/ABS_Y,
#     0..65535). Also active under QEMU, whose vmport emulates the same
#     backdoor. Depends on MOUSE_PS2 && X86 && HYPERVISOR_GUEST (defconfig).
CONFIG_MOUSE_PS2_VMMOUSE=y
# generic firmware framebuffer -> simpledrm (EFI/BIOS VGA/VESA fallback path)
CONFIG_SYSFB_SIMPLEFB=y

# --- kernel build environment constraints ---
# No OpenSSL headers on the build host -> drop the trusted-keyring cert
# extraction (we are a monolithic kernel: no module signatures needed).
# No wireless stack is shipped (no firmware), and CFG80211 pulls in the
# signed-regdb -> SYSTEM_DATA_VERIFICATION -> trusted-keyring select chain,
# so disabling it removes the openssl-dependent certs/extract-cert host tool.
CONFIG_CFG80211=n
CONFIG_SYSTEM_TRUSTED_KEYRING=n
CONFIG_SYSTEM_REVOCATION_LIST=n

# --- ORC/IBT need the host objtool (libelf/pkg-config); use the frame-pointer
#     unwinder and skip retpoline instrumentation so objtool is never required.
CONFIG_UNWINDER_ORC=n
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_X86_KERNEL_IBT=n
CONFIG_MITIGATION_RETPOLINE=n

# --- ftrace mcount would pull in objtool (HAVE_OBJTOOL_MCOUNT); not needed.
CONFIG_FUNCTION_TRACER=n

# --- VMware / hypervisor friendliness -------------------------------------
# VMware's virtual SVGA adapter (framebuffer in a VM without any extra setup)
CONFIG_DRM_VMWGFX=y
# VMware/hypervisor support: stable early consoles + precise time in a VM
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VMWARE_BALLOON=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMWARE_VMCI=y

# --- built-in kernel command line ------------------------------------------
# The EFI stub boots without a boot-manager cmdline in VMware (and ISOLINUX
# adds none), so this is the whole command line. Kernel messages go to the
# serial port (the .vmx logs serial0 to omnios-serial.log) and the screen.
# quiet: only errors while the kernel boots. Printing its ~700 boot messages
# to the screen and the serial port made the desktop appear 0.66 s later
# (tools/boot-test.py, QEMU/KVM). ominit turns the log level back up as soon
# as it runs, so OmniOS's own messages and everything after them (the
# desktop's input devices, the network, OmniOS Update) still reach the
# serial log. OmniOS Update strips this exact string from /proc/cmdline
# before restarting into an update (BUILTIN_CMDLINE in os/apps/update.c).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200n8 console=tty1 quiet"
CONFIG_CMDLINE_OVERRIDE=n

# --- OmniOS Update: restart straight into a downloaded version ---
# kexec_file_load(): the kernel checks and loads the new bzImage itself;
# init's reboot(RB_KEXEC) then starts it without going through the firmware
CONFIG_KEXEC_FILE=y

# --- network adapters: VMware's e1000/e1000e are in the defconfig; vmxnet3 ---
CONFIG_VMXNET3=y

# --- boot speed: a smaller kernel ---------------------------------------------
# The kernel image is the whole OS (the root file system is inside it), and
# firmware reads it from the CD: in the boot test, loading it from the ISO
# took 1.4 s longer than handing QEMU the same file directly. So: the zstd
# compressor (a smaller image than gzip, and the fastest to unpack; the
# initramfs inside goes in uncompressed, see scripts/build.sh), and none of
# the defconfig's parts OmniOS never uses.
CONFIG_KERNEL_GZIP=n
CONFIG_KERNEL_ZSTD=y
# Intel GPUs: VMs have their own display adapters, and on an Intel PC the
# UEFI framebuffer (simpledrm) still shows the desktop
CONFIG_DRM_I915=n
# no sound in OmniOS
CONFIG_SOUND=n
# no NFS, RAID/device-mapper or firewall: OmniOS runs from memory
CONFIG_NFS_FS=n
CONFIG_ROOT_NFS=n
CONFIG_MD=n
CONFIG_NETFILTER=n
# the defconfig's debugging aids, which also cost boot and run time
# (DEBUG_WX walks every page table at boot; DEBUG_ENTRY checks every system
# call and interrupt)
CONFIG_DEBUG_WX=n
CONFIG_DEBUG_ENTRY=n
CONFIG_DEBUG_STACK_USAGE=n
CONFIG_DEBUG_DEVRES=n
CONFIG_DEBUG_BOOT_PARAMS=n
CONFIG_EARLY_PRINTK_DBGP=n
CONFIG_PM_DEBUG=n
CONFIG_CGROUP_DEBUG=n
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_KPROBES=n
