####################################################################
# OmniOS Microwindows/Nano-X configuration
# Self-contained Linux framebuffer build: no X11, no freetype/libpng
# (their tarballs are unreachable on the OmniOS build host), so only the
# built-in BDF fonts, BMP/GIF/PNM/XPM images and the framebuffer engine.
####################################################################

############################################################
# Target platform and compilation options
############################################################
ARCH                     = LINUX-NATIVE
SHAREDLIBS               = N
SHAREDLINK               = N
EXTRAFLAGS               = -Os
DEBUG                    = N
OPTIMIZE                 = Y
VERBOSE                  = N
THREADSAFE               = N
PARALLEL                 = N

############################################################
# Screen / keyboard / mouse drivers
############################################################
SCREEN                   = FB
MOUSE                    = DEVMICEMOUSE
KEYBOARD                 = TTYKBD
SCREEN_WIDTH             = 1024
SCREEN_HEIGHT            = 768

############################################################
# Libraries to build: microwin, nano-X; NANOWM = window manager in server
############################################################
MICROWIN                 = Y
NANOX                    = Y
NUKLEARUI                = N
NX11                     = N
ENGINE                   = N
TINYWIDGETS              = N

############################################################
# Applications and demos
############################################################
FBEMULATOR               = N
MICROWINDEMO             = Y
MICROWINMULTIAPP         = N
NANOXDEMO                = Y
HAVE_VNCSERVER_SUPPORT   = N

############################################################
LINK_APP_INTO_SERVER     = N
NANOWM                   = Y

############################################################
HAVE_SHAREDMEM_SUPPORT   = Y

############################################################
HAVE_FILEIO              = Y

############################################################
# image file formats (built-in loaders only)
############################################################
HAVE_BMP_SUPPORT         = Y
HAVE_GIF_SUPPORT         = Y
HAVE_PNM_SUPPORT         = Y
HAVE_XPM_SUPPORT         = Y
HAVE_JPEG_SUPPORT        = N
HAVE_PNG_SUPPORT         = N
HAVE_TIFF_SUPPORT        = N

############################################################
# fonts: PCF, FNT and BDF-derived built-ins; no freetype/t1/harfbuzz
############################################################
HAVE_PCF_SUPPORT         = Y
HAVE_PCFGZ_SUPPORT       = N
PCF_FONT_DIR             = "fonts/pcf"
HAVE_FREETYPE_2_SUPPORT  = N
HAVE_HARFBUZZ_SUPPORT    = N
HAVE_T1LIB_SUPPORT       = N
HAVE_FNT_SUPPORT         = Y
HAVE_FNTGZ_SUPPORT       = N
FNT_FONT_DIR             = "fonts/fnt"
HAVE_HZK_SUPPORT         = N
HAVE_HBF_SUPPORT         = N
HAVE_BIG5_SUPPORT        = N
HAVE_GB2312_SUPPORT      = N
HAVE_JISX0213_SUPPORT    = N
HAVE_EUCJP_SUPPORT       = N
HAVE_KSC5601_SUPPORT     = N
HAVE_FRIBIDI_SUPPORT     = N
HAVE_SHAPEJOINING_SUPPORT = N

############################################################
# misc options
############################################################
ERASEMOVE                = Y
UPDATEREGIONS            = Y
NOFONTS                  = N
NOCLIPPING               = N
USE_EXPOSURE             = Y
VTSWITCH                 = Y
FBREVERSE                = N
GRAYPALETTE              = N
HAVETEXTMODE             = Y

############################################################
# pixel format: truecolour ARGB (works for 32bpp framebuffers)
############################################################
SCREEN_PIXTYPE           = MWPF_TRUECOLORARGB
SCREEN_DEPTH             = 32
