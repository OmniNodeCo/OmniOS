# OmniOS BusyBox configuration — curated options overlaid on the upstream
# defconfig during the build (see stage_busybox in scripts/build.sh).
#
# Every line here is either `CONFIG_X=<value>` or the canonical
# `# CONFIG_X is not set` off-form. Choices (SH_IS_*, BASH_IS_*) list all
# their members so exactly one stays selected and oldconfig does not abort
# with an inconsistent-choice prompt. Symbols verified against BusyBox 1.36.1.
CONFIG_STATIC=y

# --- shell: ash as /bin/sh and as bash emulation -------------------------
CONFIG_ASH=y
CONFIG_HUSH=y
CONFIG_SH_IS_ASH=y
# CONFIG_SH_IS_HUSH is not set
# CONFIG_SH_IS_NONE is not set
CONFIG_BASH_IS_ASH=y
# CONFIG_BASH_IS_HUSH is not set
# CONFIG_BASH_IS_NONE is not set

# --- editor / text -------------------------------------------------------
CONFIG_VI=y
CONFIG_AWK=y
CONFIG_SED=y

# --- init ----------------------------------------------------------------
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y

# --- device management (hotplug) ------------------------------------------
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y

# --- login ----------------------------------------------------------------
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_SU=y

# --- networking essentials ------------------------------------------------
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_WGET=y
CONFIG_NC=y

# --- filesystem / mount ----------------------------------------------------
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_BLKID=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y

# --- desktop-system compatibility (1.36+ symbol) --------------------------
CONFIG_DESKTOP=y

# --- build toggles ---------------------------------------------------------
# CONFIG_SELINUX is not set
CONFIG_FEATURE_EDITING_HISTORY=25
CONFIG_EXTRA_LDLIBS=""
