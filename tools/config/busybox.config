# OmniOS BusyBox configuration — static, musl-linked, full applet set.
# This config is intentionally broad (default applet set is fine for a base):
# the objective is a functional rescue/desktop shell with every common tool.
#
# Derived via: make defconfig; then:
CONFIG_STATIC=y

# --- shells ---
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_ASH=y
CONFIG_HUSH=y

# --- editor / text ---
CONFIG_VI=y
CONFIG_AWK=y
CONFIG_SED=y

# --- init ---
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y

# --- device management (hotplug) ---
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y

# --- login ---
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_SU=y

# --- networking essentials ---
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_WGET=y
CONFIG_NC=y

# --- filesystem / mount ---
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_BLKID=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_SWAPONOFF=y

# drop history to stay small
CONFIG_FEATURE_EDITING_HISTORY=25

# extra libs to link (resolv comes from musl stub libc)
CONFIG_EXTRA_LDLIBS=""

# build features we do not need
CONFIG_SELINUX=n
CONFIG_FEATURE_SYSTEMD=n
